    // SVG shield as an inline string so we can swap the inner fill/stroke
    function shield(size, state) {
      // state: 'done', 'live', 'empty'
      const w = size;
      const h = size * 1.15;
      let fill = 'none', stroke = 'rgba(0,0,0,0.18)', strokeW = 2, inner = '';
      if (state === 'done') {
        fill = '#E07850'; stroke = '#E07850';
        inner = `<path d="M${w*0.30} ${h*0.55} L${w*0.46} ${h*0.70} L${w*0.74} ${h*0.40}" stroke="#48BB78" stroke-width="${w*0.13}" stroke-linecap="round" stroke-linejoin="round" fill="none"/>`;
      } else if (state === 'live') {
        fill = 'none'; stroke = '#E07850'; strokeW = 2.5;
        inner = `<circle cx="${w*0.50}" cy="${h*0.54}" r="${w*0.10}" fill="#E07850"/>`;
      }
      return `<svg class="shield-svg" viewBox="0 0 ${w} ${h}" width="${w}" height="${h}" aria-hidden="true">
        <path d="M${w*0.50} ${h*0.05}
                 C${w*0.78} ${h*0.05} ${w*0.95} ${h*0.10} ${w*0.95} ${h*0.25}
                 L${w*0.95} ${h*0.50}
                 C${w*0.95} ${h*0.78} ${w*0.75} ${h*0.94} ${w*0.50} ${h*0.97}
                 C${w*0.25} ${h*0.94} ${w*0.05} ${h*0.78} ${w*0.05} ${h*0.50}
                 L${w*0.05} ${h*0.25}
                 C${w*0.05} ${h*0.10} ${w*0.22} ${h*0.05} ${w*0.50} ${h*0.05} Z"
              fill="${fill}" stroke="${stroke}" stroke-width="${strokeW}" stroke-linejoin="round"/>
        ${inner}
      </svg>`;
    }

    function tabbar(activeIdx) {
      const tabs = [
        { i: '🏠', label: 'Home' },
        { i: '🛡', label: 'Pledge' },
        { i: '💼', label: 'Wallet' },
        { i: '👥', label: 'Friends' },
        { i: '👤', label: 'Profile' },
      ];
      return `<div class="ps-tabbar">${tabs.map((t, idx) => `
        <div class="ps-tab${idx === activeIdx ? ' active' : ''}">
          <div class="ps-tab-icon">${t.i}</div>
          <div>${t.label}</div>
        </div>`).join('')}</div>`;
    }

