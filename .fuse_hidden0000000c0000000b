            </div>
          </div>
        </div>
        ${tabbar(0)}`;
      }

      // -------- Friends --------
      if (kind === 'friends') {
        return `<div class="ps-statusbar"></div>
        <div class="ps-content" style="padding: 8px 14px 4px;">
          <div class="ps-title">Friends</div>
          <div class="friends-banner">
            <span>👋 1 unseen poke</span>
            <span style="font-size: 8px;">Mark all seen</span>
          </div>
          <div class="friends-actions">
            <div class="ps-btn-fill ${hl === 'addFriend' ? 'hl-pill' : ''}" style="border-radius: 10px; padding: 6px;">
              👤+ Add Friend
            </div>
            <div class="ps-btn-outline" style="padding: 6px;">Pending</div>
          </div>
          <div class="friend-card has-poke ${hl === 'friendProgress' ? 'hl' : ''}">
            <div class="inline-poke">👋 Jordan M. poked you · 8:32 AM</div>
            <div class="fr-head">
              <div class="ps-avatar" style="width: 24px; height: 24px; font-size: 9px;">JM</div>
              <div style="flex: 1;">
                <div class="fr-name">Jordan M.</div>
                <div class="fr-progress">3 / 4 this week</div>
              </div>
              <div class="fr-bell">🔔</div>
              <div class="ps-btn-fill" style="padding: 3px 7px;">Poke Back</div>
            </div>
            <div class="fr-shields">
              ${shield(14, 'done')}
              ${shield(14, 'done')}
              ${shield(14, 'done')}
              ${shield(14, 'empty')}
            </div>
          </div>
          <div class="friend-card">
            <div class="fr-head">
              <div class="ps-avatar plum" style="width: 24px; height: 24px; font-size: 9px;">SR</div>
              <div style="flex: 1;">
                <div class="fr-name">Sam R.</div>
                <div class="fr-progress">1 / 4 this week</div>
              </div>
              <div class="fr-bell off">🔕</div>
              <div class="ps-btn-outline ${hl === 'poke' ? 'hl-pill' : ''}" style="padding: 3px 7px; font-size: 8.5px;">👋 Poke</div>
            </div>
            <div class="fr-shields">
              ${shield(14, 'done')}
              ${shield(14, 'empty')}
              ${shield(14, 'empty')}
              ${shield(14, 'empty')}
            </div>
          </div>
        </div>
        ${tabbar(3)}`;
      }

      // -------- History --------
      if (kind === 'history') {
        return `<div class="ps-statusbar"></div>
        <div class="ps-content" style="padding: 8px 14px 4px;">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 9px;">
            <div class="ps-title" style="margin: 0;">History</div>
            <div class="ps-pill pill-green">✓ 6 / 6 won</div>
          </div>
          <div class="hist-stats">
            <div class="col"><div class="value">6 wks</div><div class="label">Streak</div></div>
            <div class="col"><div class="value coral">2,125</div><div class="label">Earned</div></div>
            <div class="col"><div class="value">$0</div><div class="label">Charges</div></div>
          </div>
          <div style="font-size: 8.5px; font-weight: 700; color: rgba(0,0,0,0.4); letter-spacing: 0.12em; margin: 7px 2px 4px;">ALL WEEKS</div>
          <div class="week-row ${hl === 'historyRow' ? 'hl' : ''}">
            <div class="week-icon">⏱</div>
            <div class="info">
              <div class="title">Week of May 4</div>
              <div class="sub coral">Awaiting payout</div>
            </div>
            <div class="ps-pill pill-sage">Passed</div>
          </div>
          <div class="week-row">
            <div class="week-icon green">✓</div>
            <div class="info">
              <div class="title">Week of Apr 27</div>
              <div class="sub" style="color: var(--app-goal-green);">+ 375 pts</div>
            </div>
            <div class="ps-pill pill-green">Passed</div>
          </div>
          <div class="week-row">
            <div class="week-icon green">✓</div>
            <div class="info">
              <div class="title">Week of Apr 20</div>
              <div class="sub" style="color: var(--app-goal-green);">+ 500 pts</div>
            </div>
            <div class="ps-pill pill-green">Passed</div>
          </div>
        </div>
        ${tabbar(1)}`;
      }

      // -------- Wallet --------
      if (kind === 'wallet') {
        return `<div class="ps-statusbar"></div>
        <div class="ps-content" style="padding: 8px 14px 4px;">
          <div class="ps-title">Wallet</div>
          <div class="wallet-hero ${hl === 'points' ? 'hl' : ''}">
            <div class="wh-label">POINTS</div>
            <div class="wh-value">1,625</div>
            <div class="wh-sub">Available to redeem</div>
            <div class="wh-actions">
              <div class="wh-pill-coral ${hl === 'redeem' ? 'hl-pill' : ''}">🎁 Redeem</div>
              <div class="wh-pill-white">⚠ Disputes</div>
            </div>
            <div class="wh-divider"></div>
            <div class="wh-stats">
              <div class="col"><div class="label">ALL-TIME</div><div class="v">2,125</div></div>
              <div class="col"><div class="label">REDEEMED</div><div class="v">500</div></div>
              <div class="col"><div class="label">DONATED</div><div class="v">$0</div></div>
            </div>
          </div>
          <div style="font-size: 8.5px; font-weight: 700; color: rgba(0,0,0,0.4); letter-spacing: 0.12em; margin: 7px 2px 4px;">LIFETIME</div>
          <div class="lifetime-row">
            <div class="lifetime-card">
              <div class="lc-icon" style="color: var(--app-coral);">🛡</div>
              <div class="lc-val">5</div>
              <div class="lc-label">Weeks won</div>
            </div>
            <div class="lifetime-card">
              <div class="lc-icon" style="color: var(--app-goal-green);">🏃</div>
              <div class="lc-val">40</div>
              <div class="lc-label">Workouts</div>
            </div>
            <div class="lifetime-card">
              <div class="lc-icon" style="color: #E59100;">⏱</div>
              <div class="lc-val">16.4</div>
              <div class="lc-label">Hours</div>
            </div>
          </div>
        </div>
        ${tabbar(2)}`;
      }

      // -------- Dispute --------
      if (kind === 'dispute') {
        return `<div class="ps-statusbar"></div>
        <div class="ps-content" style="padding: 8px 14px 4px;">
          <div class="dispute-hdr">Week of Apr 14</div>
          <div class="dispute-result">
            <div class="x-circle">✕</div>
            <div class="gm">Goal Missed</div>
            <div class="sub">3 of 4 days · −$10</div>
          </div>
          <div class="dispute-window">
            <div class="dw-head">
              <span class="clock">⏱</span>
              <div>
                <div><strong>Dispute window open</strong></div>
                <div style="font-size: 8.5px; color: rgba(0,0,0,0.5);">Closes Wed at 11:59 PM</div>
              </div>
            </div>
            <div class="dw-help">If a workout wasn't tracked correctly, file a dispute before the window closes.</div>
            <div class="dispute-btn ${hl === 'fileDispute' ? 'hl-pill' : ''}">💬 File Dispute</div>
          </div>
        </div>
        ${tabbar(1)}`;
      }

      // -------- Redemption --------
      if (kind === 'redeem') {
        return `<div class="ps-statusbar"></div>
        <div class="ps-content" style="padding: 8px 14px 4px;">
          <div class="redeem-hdr">
            <div class="title">Redeem Points</div>
            <div class="redeem-cancel">Cancel</div>
          </div>
          <div class="redeem-balance">Available: 1,625 pts <span class="sage">($16.25)</span></div>
          <div class="seg-control">
            <div class="seg ${hl === 'giftTab' ? 'active hl-pill' : (hl === 'donateTab' ? '' : 'active')}">🎁 Gift Cards</div>
            <div class="seg ${hl === 'donateTab' ? 'active hl-pill' : ''}">💛 Donate</div>
          </div>
          <div class="gift-tier">
            <div class="gt-icon">🎁</div>
            <div><div class="gt-name">$5 Amazon</div><div class="gt-cost">500 pts</div></div>
            <div class="gt-action">›</div>
          </div>
          <div class="gift-tier">
            <div class="gt-icon">🎁</div>
            <div><div class="gt-name">$10 Amazon</div><div class="gt-cost">1,000 pts</div></div>
            <div class="gt-action">›</div>
          </div>
          <div class="gift-tier locked">
            <div class="gt-icon">🔒</div>
            <div><div class="gt-name">$25 Amazon</div><div class="gt-cost">2,500 pts</div></div>
            <div class="gt-action">Need 875</div>
          </div>
          <div class="gift-tier locked">
            <div class="gt-icon">🔒</div>
            <div><div class="gt-name">$50 Amazon</div><div class="gt-cost">5,000 pts</div></div>
            <div class="gt-action">Need 3,375</div>
          </div>
        </div>
        ${tabbar(2)}`;
      }

      // -------- Finish --------
      if (kind === 'finish') {
        return `<div class="ps-statusbar"></div>
        <div class="ps-content">
          <div class="finish">
            <div class="check-circle">✓</div>
            <h3>You're all set</h3>
            <p>Time to make your first pledge.</p>
            <div class="ps-btn-primary" style="padding: 9px 22px;">Get Started</div>
          </div>
        </div>`;
      }

      return '';
    }

    // ===== 11 reduced steps =====
    const STEPS = [
      { kind: 'splash',       hl: null,           title: 'Welcome to Workout Pledge',
        body: 'A quick tour so you know how the app works before your first pledge — about a minute.' },

      { kind: 'homeInactive', hl: 'createBtn',    title: 'Start with a pledge',
        body: 'On the Home screen, tap <strong>Create My Pledge</strong> to pick how many days you want to work out next week and how much you’ll forfeit if you miss.' },

      { kind: 'health',       hl: 'watchStart',   title: 'Workouts log automatically',
        body: 'Start a workout on your Apple Watch (or any source that writes to Apple Health). It syncs to us automatically — <strong>30 min/day</strong> per committed day, and multiple sessions stack.' },

      { kind: 'homeActive',   hl: 'shields',      title: 'Track your week at a glance',
        body: 'Filled shields are days you hit your goal. The daily list shows exactly where you stand and what’s <strong>at risk</strong> if you don’t finish.' },

      { kind: 'friends',      hl: 'addFriend',    title: 'Bring your friends',
        body: 'Tap <strong>Add Friend</strong> to share an invite link. Once they sign up, you’ll see each other’s weekly progress.' },

      { kind: 'friends',      hl: 'poke',         title: 'Poke a friend who’s behind',
        body: 'If someone’s gone quiet, tap <strong>Poke</strong> and they’ll get a friendly nudge. Bell icon controls notifications for each friend.' },

      { kind: 'history',      hl: 'historyRow',   title: 'Every week, remembered',
        body: 'Pledge History shows your streak, points earned, and every settled week. Tap any week for the daily breakdown.' },

      { kind: 'wallet',       hl: 'points',       title: 'Your points live in the Wallet',
        body: 'Earned the Monday after each successful week ends — that’s one week after the pledge week closes, giving the 3-day dispute window time to settle.' },

      { kind: 'dispute',      hl: 'fileDispute',  title: 'Disputes — for emergencies only',
        body: 'Dead phone, broken watch, medical issue? <strong>File a dispute</strong> within 3 days of week-end and we’ll review. Not for "I was busy" — you can do any workout, anywhere.' },

      { kind: 'redeem',       hl: 'giftTab',      title: 'Cash out or give back',
        body: 'Tap <strong>Redeem</strong> in your Wallet. Pick an Amazon gift card in your local currency, or switch to the <strong>Donate</strong> tab to give to a vetted nonprofit.' },

      { kind: 'finish',       hl: null,           title: 'You’re ready',
        body: 'That’s the whole app. Join the waitlist and we’ll let you know the moment you can set up your first pledge.' },
    ];

    const total = STEPS.length;
    let idx = 0;

    const phoneSlot = document.getElementById('phoneSlot');
    const stepCounter = document.getElementById('stepCounter');
    const stepTitle = document.getElementById('stepTitle');
    const stepBody = document.getElementById('stepBody');
    const progressFill = document.getElementById('progressFill');
    const dotsWrap = document.getElementById('dots');
    const prevBtn = document.getElementById('prevBtn');
    const nextBtn = document.getElementById('nextBtn');

    for (let i = 0; i < total; i++) {
      const d = document.createElement('button');
      d.className = 'dot';
      d.setAttribute('role', 'tab');
      d.setAttribute('aria-label', `Go to step ${i + 1}`);
      d.addEventListener('click', () => goTo(i));
      dotsWrap.appendChild(d);
    }

    function render() {
      const s = STEPS[idx];
      const screenEl = document.createElement('div');
      screenEl.className = 'phone-frame';
      const inner = document.createElement('div');
      inner.className = 'phone-screen';
      inner.innerHTML = buildScreen(s.kind, s.hl);
      screenEl.appendChild(inner);
      phoneSlot.innerHTML = '';
      phoneSlot.appendChild(screenEl);

      stepCounter.textContent = `Step ${idx + 1} of ${total}`;
      stepTitle.textContent = s.title;
      stepBody.innerHTML = s.body;

      const pct = ((idx + 1) / total) * 100;
      progressFill.style.width = pct + '%';

      [...dotsWrap.children].forEach((d, i) => {
        d.classList.toggle('active', i === idx);
        d.classList.toggle('visited', i < idx);
      });

      prevBtn.disabled = idx === 0;
      nextBtn.disabled = idx === total - 1;
      nextBtn.setAttribute('aria-label', idx === total - 1 ? 'End of tour' : 'Next step');

      if (typeof gtag === 'function') {
        gtag('event', 'tour_step_view', { step_index: idx + 1, step_title: s.title });
      }
    }

    function goTo(n) { idx = Math.max(0, Math.min(total - 1, n)); render(); }
    function next() { if (idx < total - 1) goTo(idx + 1); }
    function prev() { if (idx > 0) goTo(idx - 1); }

    prevBtn.addEventListener('click', prev);
    nextBtn.addEventListener('click', next);

    document.addEventListener('keydown', (e) => {
      if (e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA') return;
      if (e.key === 'ArrowRight') next();
      else if (e.key === 'ArrowLeft') prev();
      else if (e.key === 'Home') goTo(0);
      else if (e.key === 'End') goTo(total - 1);
    });

    let startX = null;
    const card = document.getElementById('tourCard');
    card.addEventListener('touchstart', (e) => { startX = e.touches[0].clientX; }, { passive: true });
    card.addEventListener('touchend', (e) => {
      if (startX === null) return;
      const dx = e.changedTouches[0].clientX - startX;
      if (Math.abs(dx) > 40) (dx < 0 ? next() : prev());
      startX = null;
    });

    render();
  </script>

</body>
